# Example environment variables for Sonora API

# Port the app will listen on (Render provides PORT automatically).
PORT=8000

# Option A (recommended): base64-encoded cookies.txt content.
# Use this when you store secrets in Render / Kubernetes / CI.
# Example (Linux):
#   export B64=$(base64 -w0 cookies.txt)
#   # then set YTDLP_COOKIES_B64 to $B64 in your secret manager
YTDLP_COOKIES_B64=

# Option B: path to a cookies file mounted inside the container
# (if you mount /app/cookies.txt directly, you don't need these vars)
YTDLP_COOKIES_FILE=/app/cookies.txt

# Option C: raw cookies file contents (less secure)
# YTDLP_COOKIES=""

# Optional: protect the cookies upload endpoints with an API key
# If set, include header: Authorization: Bearer <key> or X-API-Key: <key>
YTDLP_COOKIES_API_KEY=changeme

# Misc (not required):
# LOG_LEVEL=info
