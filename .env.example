# Example environment variables for Sonora API

# Port the app will listen on (Render provides PORT automatically).
PORT=8000

# Optional secondary download backend. Render's Blueprint now wires this
# automatically to the self-hosted Cobalt service.
COBALT_URL=
COBALT_API_KEY=

# Optional direct yt-dlp cookies. These are OFF by default because YouTube
# session cookies rotate and should not be required for public videos.
YTDLP_USE_COOKIES=false
YTDLP_COOKIES_B64=
YTDLP_COOKIES_FILE=/app/cookies.txt

# Optional: protect the cookies upload endpoints with an API key.
# If set, include header: Authorization: Bearer <key> or X-API-Key: <key>
YTDLP_COOKIES_API_KEY=changeme

# Optional direct yt-dlp proxy.
YTDLP_PROXY=

# Optional: override the client profiles without changing code.
# Example: tv,web_safari;web_embedded;android_vr
YTDLP_PLAYER_PROFILES=
